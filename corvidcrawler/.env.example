# Copy to .env (gitignored). The repo-root .env is read too, so DATA_DIR set
# there once covers this as well.

# Free from https://xeno-canto.org/account — the value below is a placeholder.
XENOCANTO_KEY=replace-with-your-xeno-canto-key

# Where the corpus lives. Defaults to data/ at the repo root.
# DATA_DIR=/absolute/path/to/data

# What the archives see in the User-Agent header. Give them a way to reach you.
# CRAWLER_USER_AGENT=CrowGPT corpus crawler (contact: you@example.org)
