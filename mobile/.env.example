# Copy to .env and fill in. .env is gitignored; nothing location-specific
# belongs in the source.

# Where `make seed` scatters test captures. Your own coordinates go here.
MAP_CENTER_LAT=
MAP_CENTER_LNG=

# Default field server baked into the app build. Use the LAN address
# `make field` prints, so a fresh install can sync over Wi-Fi without
# retyping it. Only EXPO_PUBLIC_* variables reach the bundle.
EXPO_PUBLIC_FIELD_SERVER_URL=
