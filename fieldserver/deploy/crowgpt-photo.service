[Unit]
Description=CrowGPT photo worker
After=crowgpt-field.service
Requires=crowgpt-field.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/crowgpt/fieldserver
EnvironmentFile=/home/ubuntu/crowgpt/fieldserver/instance/service.env
Environment=MALLOC_ARENA_MAX=2
Environment=PHOTO_ID_MODEL=/home/ubuntu/crowgpt/data/photos/models/photo-id
ExecStart=/home/ubuntu/crowgpt/analyzer/photo/.venv/bin/python worker/photo_worker.py
MemoryMax=2600M
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
