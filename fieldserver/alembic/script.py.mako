"""${message}

Why, not what — the operations below say what. A revision that only restates
its own SQL in prose is one nobody reads twice.

Use `op.batch_alter_table` for anything SQLite has no ALTER for: dropping a
column, changing a NOT NULL, changing a type. `render_as_batch` is on in env.py,
so autogenerated operations already do this.

Revision ID: ${up_revision}
Revises: ${down_revision | comma,n}
"""

from alembic import op
import sqlalchemy as sa
${imports if imports else ""}

revision = ${repr(up_revision)}
down_revision = ${repr(down_revision)}
branch_labels = ${repr(branch_labels)}
depends_on = ${repr(depends_on)}


def upgrade() -> None:
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    ${downgrades if downgrades else 'raise NotImplementedError("not reversible")'}
